<div class="bento">
{% for post in pagination.items %}
<div class="bento-card span-6">
<a href="{{post.url}}">
{% if metadata.image %}<img class="img-post" 
width="100%" height="100%"
alt="{{post.title}}"
src="{{post.image or metadata.image}}"
/>{% endif %}
</a>
<h2 class="mb-3"><a href="{{post.url}}">{{post.title}}</a></h2>
<p>{{post.description}}</p>
</div>
{% endfor %}
</div>